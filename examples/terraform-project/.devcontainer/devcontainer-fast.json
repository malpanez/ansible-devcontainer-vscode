{
  "name": "Terraform Project Development (Fast - No Build)",
  "image": "ghcr.io/malpanez/devcontainer-terraform-aws:v2.0.0@sha256:35a36c0714583f518540708f3740cd42f2968d94a806eaea2f636e7d0231ef4a",

  "containerEnv": {
    "PRE_COMMIT_HOME": "/home/vscode/.cache/pre-commit"
  },

  "customizations": {
    "vscode": {
      "settings": {
        "terraform.languageServer.enable": true,
        "terraform.codelens.enabled": true,
        "terraform.experimentalFeatures.prefillRequiredFields": true,
        "[terraform]": {
          "editor.defaultFormatter": "hashicorp.terraform",
          "editor.formatOnSave": true,
          "editor.insertSpaces": true,
          "editor.tabSize": 2
        },
        "[terraform-vars]": {
          "editor.defaultFormatter": "hashicorp.terraform",
          "editor.formatOnSave": true
        }
      },
      "extensions": [
        "hashicorp.terraform",
        "eamodio.gitlens",
        "ms-azuretools.vscode-docker",
        "github.vscode-github-actions"
      ]
    }
  },

  // This example opts in to the host's ~/.aws, so the directory must exist on
  // the host or the container will not start.
  "mounts": [
    "source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind,readonly",
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,readonly"
  ],

  "postCreateCommand": [
    "bash",
    "-lc",
    "set -euo pipefail; sudo mkdir -p /home/vscode/.cache/pre-commit; sudo chown -R vscode:vscode /home/vscode/.cache; pre-commit install --install-hooks || true; terraform init || true"
  ],

  "remoteUser": "vscode"
}
