{
  "name": "Terraform Project Development (Fast - No Build)",
  "image": "ghcr.io/malpanez/devcontainer-terraform-aws:v2.2.2@sha256:e72b0da2b038e7a6396f17aa438c427821b1cf3e01a6ce9ff3e761cbb38787b2",

  "containerEnv": {
    "PRE_COMMIT_HOME": "/home/vscode/.cache/pre-commit"
  },

  "customizations": {
    "vscode": {
      "settings": {
        "terraform.languageServer.enable": true,
        "terraform.codelens.enabled": true,
        "terraform.experimentalFeatures.prefillRequiredFields": true,
        "[terraform]": {
          "editor.defaultFormatter": "hashicorp.terraform",
          "editor.formatOnSave": true,
          "editor.insertSpaces": true,
          "editor.tabSize": 2
        },
        "[terraform-vars]": {
          "editor.defaultFormatter": "hashicorp.terraform",
          "editor.formatOnSave": true
        }
      },
      "extensions": [
        "hashicorp.terraform",
        "eamodio.gitlens",
        "ms-azuretools.vscode-docker",
        "github.vscode-github-actions"
      ]
    }
  },

  // This example opts in to the host's ~/.aws, so the directory must exist on
  // the host or the container will not start.
  "mounts": [
    "source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind,readonly",
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,readonly"
  ],

  "postCreateCommand": [
    "bash",
    "-lc",
    "set -euo pipefail; ensure-precommit && terraform init -backend=false"
  ],

  "remoteUser": "vscode"
}
