{
  "name": "Terraform Project Development",
  "image": "ghcr.io/malpanez/devcontainer-terraform-aws:v2.2.0@sha256:eccea5f3a5e92fd7b125bfae967a11b5ddcf98afff6ae4560d3fa37c2412a8e5",
  "remoteUser": "vscode",

  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.terraform",
        "eamodio.gitlens",
        "ms-azuretools.vscode-docker",
        "github.vscode-github-actions"
      ],
      "settings": {
        "terraform.languageServer.enable": true,
        "terraform.codelens.enabled": true,
        "terraform.experimentalFeatures.prefillRequiredFields": true,
        "[terraform]": {
          "editor.defaultFormatter": "hashicorp.terraform",
          "editor.formatOnSave": true,
          "editor.insertSpaces": true,
          "editor.tabSize": 2
        },
        "[terraform-vars]": {
          "editor.defaultFormatter": "hashicorp.terraform",
          "editor.formatOnSave": true
        }
      }
    }
  },

  // This example opts in to the host's ~/.aws, so the directory must exist on
  // the host or the container will not start.
  "mounts": [
    "source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind,readonly",
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,readonly"
  ],

  "postCreateCommand": "ensure-precommit && terraform init -backend=false",

  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind"
}
