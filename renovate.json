{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Raised from 10 on 2026-08-17. With ~26 dependencies moving per week and auto-merge on green, a limit of 10 protected nothing \u2014 it just hid work: 26 updates sat in the dashboard's Rate-Limited section, including the golang 1.26.6 and python 3.14.7 bumps that left ~87 code-scanning alerts open for weeks, and the ansible 14.3.1 bump whose absence broke develop's CI. 30 covers the weekly volume with headroom while still capping a runaway.",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "baseBranchPatterns": [
    "develop"
  ],
  "timezone": "Europe/Madrid",
  "labels": [
    "dependencies"
  ],
  "semanticCommitScope": "deps",
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 30,
  "prHourlyLimit": 0,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "at any time"
    ]
  },
  "packageRules": [
    {
      "description": "Do not try to pin GitHub Actions runner labels (ubuntu-latest etc.)",
      "matchDatasources": [
        "github-runners"
      ],
      "enabled": false
    },
    {
      "description": "Auto-merge digest, pin, lockfile and non-major updates on green (develop is protected by CI Success)",
      "matchUpdateTypes": [
        "digest",
        "pin",
        "lockFileMaintenance",
        "patch",
        "minor"
      ],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Group all GitHub Actions bumps",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Group the terraform-stack CLI tools",
      "matchFileNames": [
        "devcontainers/terraform/Dockerfile"
      ],
      "groupName": "terraform-stack tools"
    },
    {
      "description": "Group the AWS Python SDK: boto3/botocore/s3transfer ship as one lockstep release train, so separate PRs each rewrite uv.lock and the second one always lands in conflict (2026-07-24 and 2026-07-27, both times)",
      "matchPackageNames": [
        "boto3",
        "botocore",
        "s3transfer"
      ],
      "groupName": "aws-sdk-python"
    },
    {
      "description": "requirements.txt and requirements-ansible.txt are generated from uv.lock by `uv export`. Renovate was editing them as if they were manifests, which silently desynchronised them from the lock (cffi, filelock, python-discovery and virtualenv were all newer in the exports than in the lock, and the next regeneration would have reverted them - including the security fix). Let Renovate manage pyproject/uv.lock only; the companion regenerates the exports.",
      "matchFileNames": [
        "requirements.txt",
        "requirements-ansible.txt"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "uv version pinned as an ARG across the Dockerfiles",
      "managerFilePatterns": [
        "/devcontainers/.+/Dockerfile.*/"
      ],
      "matchStrings": [
        "ARG UV_VERSION=\"?(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\"?"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "astral-sh/uv"
    },
    {
      "customType": "regex",
      "description": "uv version in the ansible_environment role default",
      "managerFilePatterns": [
        "/roles/ansible_environment/defaults/main\\.yml/"
      ],
      "matchStrings": [
        "uv_version \\| default\\('(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)'"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "astral-sh/uv"
    },
    {
      "customType": "regex",
      "description": "terraform CLI pinned as an ARG",
      "managerFilePatterns": [
        "/devcontainers/terraform/Dockerfile/"
      ],
      "matchStrings": [
        "ARG TERRAFORM_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "hashicorp/terraform",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "terragrunt CLI pinned as an ARG",
      "managerFilePatterns": [
        "/devcontainers/terraform/Dockerfile/"
      ],
      "matchStrings": [
        "ARG TERRAGRUNT_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "gruntwork-io/terragrunt",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "tflint CLI pinned as an ARG",
      "managerFilePatterns": [
        "/devcontainers/terraform/Dockerfile/"
      ],
      "matchStrings": [
        "ARG TFLINT_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "terraform-linters/tflint",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "sops CLI pinned as an ARG",
      "managerFilePatterns": [
        "/devcontainers/terraform/Dockerfile/"
      ],
      "matchStrings": [
        "ARG SOPS_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "getsops/sops",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "age (hash recomputed by a postUpgradeTask)",
      "managerFilePatterns": [
        "/devcontainers/terraform/Dockerfile/"
      ],
      "matchStrings": [
        "ARG AGE_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "FiloSottile/age",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "aws-cli (git tags, hash recomputed by a postUpgradeTask)",
      "managerFilePatterns": [
        "/devcontainers/terraform/Dockerfile/"
      ],
      "matchStrings": [
        "ARG AWS_CLI_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "aws/aws-cli"
    },
    {
      "customType": "regex",
      "description": "tectonic (tag is tectonic@X.Y.Z; hash recomputed by a postUpgradeTask)",
      "managerFilePatterns": [
        "/devcontainers/latex/Dockerfile/"
      ],
      "matchStrings": [
        "ARG TECTONIC_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "tectonic-typesetting/tectonic",
      "extractVersionTemplate": "^tectonic@(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Versions pinned as *_VERSION env vars in workflows, tagged with a '# renovate:' annotation. Without this, pinning a tool version would freeze it forever \u2014 exactly how main ended up building from a base digest GHCR had already pruned (2026-07-24).",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+[A-Z_]+_VERSION:\\s*[\"']?(?<currentValue>[^\"'\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "pre-commit pinned as an ARG in the base image",
      "managerFilePatterns": [
        "/devcontainers/base/Dockerfile/"
      ],
      "matchStrings": [
        "ARG PRE_COMMIT_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "pre-commit"
    }
  ],
  "vulnerabilityAlerts": {
    "description": "Security fixes must not wait for a human. The automerge rule below covers only patch/minor, so the cryptography 49->50 fix for a HIGH Bleichenbacher advisory sat open for six days purely because it was a major. CI still gates it: a red pipeline means no merge.",
    "automerge": true,
    "labels": [
      "dependencies",
      "security"
    ]
  }
}
