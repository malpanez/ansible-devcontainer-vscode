# syntax=docker/dockerfile:1.28
# Ansible DevContainer with Podman + Execution Environments
#
# Podman comes from Debian's own packages (trixie ships 5.4.x with
# Debian security backports). The previous approach — copying binaries
# from quay.io/containers/podman — never worked at runtime: those are
# Fedora builds that need GLIBC 2.38, libsubid.so.5 and libgpgme.so.45,
# none of which exist on the Debian bases.
# Debian 13 like the other Debian stacks, and it has to be: podman >= 5
# needs the userland bookworm does not have.
# Stage 1: trixie + checksum-verified uv, shared by builder and runtime
FROM python:3.14-slim-trixie@sha256:cd89c30eda26ee911a4611b18680086e0ea42e6f5f8cbe653d07fa7958c9cec8 AS uv-base

# renovate: datasource=github-releases depName=astral-sh/uv
ARG UV_VERSION="0.13.6"

# LANG: the python base sets it on some digests only (3.14.8 did not, 3.14.10
# does), so a digest bump could turn it off.
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    UV_INSTALL_DIR=/usr/local/bin \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

# hadolint ignore=DL3008
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
    && rm -rf /var/lib/apt/lists/* \
    # This stage is also the runtime's base, so these reach the image. dpkg,
    # apt and ldconfig write the wall-clock time into them on every run, and
    # rewrite-timestamp clamps mtimes, not contents: kept, they made two
    # builds of one commit differ.
    && rm -f /var/log/dpkg.log /var/log/alternatives.log \
         /var/log/apt/history.log /var/log/apt/term.log \
         /var/cache/ldconfig/aux-cache

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Install uv with pinned version (direct binary, no pipe-to-shell)
RUN set -eux; \
    case "$(dpkg --print-architecture)" in \
      amd64) UV_ARCH="x86_64-unknown-linux-musl" ;; \
      arm64) UV_ARCH="aarch64-unknown-linux-musl" ;; \
      *) printf 'Unsupported arch: %s\n' "$(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac; \
    curl --proto '=https' --tlsv1.2 -fsSL --retry 5 --retry-delay 2 --retry-max-time 120 "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-${UV_ARCH}.tar.gz" \
      -o "/tmp/uv-${UV_ARCH}.tar.gz"; \
    curl --proto '=https' --tlsv1.2 -fsSL --retry 5 --retry-delay 2 --retry-max-time 120 "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-${UV_ARCH}.tar.gz.sha256" \
      -o "/tmp/uv-${UV_ARCH}.tar.gz.sha256"; \
    echo "$(cut -d' ' -f1 "/tmp/uv-${UV_ARCH}.tar.gz.sha256")  /tmp/uv-${UV_ARCH}.tar.gz" | sha256sum -c -; \
    tar -xzf "/tmp/uv-${UV_ARCH}.tar.gz" -C /tmp; \
    install -m 755 "/tmp/uv-${UV_ARCH}/uv" /usr/local/bin/uv; \
    install -m 755 "/tmp/uv-${UV_ARCH}/uvx" /usr/local/bin/uvx; \
    rm -rf "/tmp/uv-${UV_ARCH}.tar.gz" "/tmp/uv-${UV_ARCH}.tar.gz.sha256" "/tmp/uv-${UV_ARCH}"

# Stage 2: install the locked Python stack. Build tools live only here —
# arm64 needs gcc + libonig-dev for onigurumacffi (no aarch64 wheel).
FROM uv-base AS python-builder

# hadolint ignore=DL3008
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
      gcc \
      libc6-dev \
      libffi-dev \
      libonig-dev \
    && rm -rf /var/lib/apt/lists/*

# The hashed uv.lock export, the same one the main Dockerfile installs. It
# already carries ansible-navigator and ansible-builder (a navigator
# dependency), which this stage used to add on top, unpinned.
COPY requirements-ansible.txt /tmp/requirements-ansible.txt

# CFLAGS=-g0 because arm64 compiles onigurumacffi here from its sdist, and
# the -g in Python's own CFLAGS wrote uv's randomly named build directory
# into the .so's debug info, so the file differed in every build.
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    CFLAGS=-g0 UV_COMPILE_BYTECODE=0 uv pip install --system --require-hashes -r /tmp/requirements-ansible.txt

# The same pinned collections as the main Dockerfile: see collections.txt.
COPY devcontainers/ansible/collections.txt devcontainers/ansible/install-collections.sh /tmp/ansible-collections/
RUN SITE="$(python3 -c 'import sysconfig; print(sysconfig.get_path("purelib"))')" \
    && bash /tmp/ansible-collections/install-collections.sh "${SITE}" /tmp/ansible-collections/collections.txt

# Checked-hash bytecode instead of uv's timestamp .pyc, which the
# exporter's rewrite-timestamp would leave stale, pip left uncompiled, and
# every directory touched afterwards: see devcontainers/base for all three.
# None for ansible_collections, which ansible-core never imports through
# __pycache__: see the main Dockerfile.
RUN SITE="$(python3 -c 'import sysconfig; print(sysconfig.get_path("purelib"))')" \
    && python3 -m compileall -q -f -j 0 --invalidation-mode checked-hash \
         -x '/site-packages/(pip|ansible_collections)/' "${SITE}" \
    && find "$(dirname "${SITE}")" -type d -exec touch {} +

# Stage 3: runtime image with Podman, no build toolchain
FROM uv-base

ARG IMAGE_VENDOR="malpanez"

LABEL org.opencontainers.image.source="https://github.com/malpanez/ansible-devcontainer-vscode" \
      org.opencontainers.image.description="Ansible devcontainer with Podman for Execution Environments" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="${IMAGE_VENDOR}"

ENV WORKSPACE=/workspace \
    DEVCONTAINER_STACK=ansible \
    DEVCONTAINER_TEMPLATE_ROOT=/usr/local/share/devcontainer-skel

# Install system dependencies for Podman rootless.
# libonig5 is the runtime library behind the source-built onigurumacffi
# on arm64. Note: git is installed via apt (no feature git:1); NOT
# installing tini since we use --init in runArgs.
# gh comes from cli.github.com, as in devcontainers/base. Debian's package is
# 2.46.0, and https://github.com/cli/cli/blob/trunk/docs/install_linux.md says
# of it: "community-distributed 2.45.x / 2.46.x version is broken due to
# deprecated GitHub APIs". apt takes the newer of the two versions it then has.
# The same page publishes the keyring's SHA256 checked below.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# hadolint ignore=DL3008
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    curl --proto '=https' --tlsv1.2 -fsSL --retry 5 --retry-delay 2 --retry-max-time 120 https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "6084d5d7bd8e288441e0e94fc6275570895da18e6751f70f057485dc2d1a811b  /usr/share/keyrings/githubcli-archive-keyring.gpg" | sha256sum -c - \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
      # Base tools plus podman (Debian build, ABI-coherent) and its
      # rootless dependencies: conmon, crun, dbus-user-session,
      # fuse-overlayfs, iptables, passt, slirp4netns, uidmap. passt carries
      # pasta, the default rootless network since podman 5: without it
      # `podman run` stopped at "could not find pasta".
      # One alphabetical list, not grouped sublists (docker:S7018).
      conmon \
      crun \
      dbus-user-session \
      fuse-overlayfs \
      gh \
      git \
      iptables \
      libcap2-bin \
      libonig5 \
      openssh-client \
      passt \
      podman \
      rsync \
      slirp4netns \
      uidmap \
      unzip \
    # Upgrade AFTER the install, never before: the packages that go stale
    # here are mostly ones apt pulls in as dependencies of the list above
    # (perl via debconf, libc6, libglib2.0-0t64), so an upgrade placed
    # first never reaches them. That ordering mistake is what left
    # CVE-2026-7598 unpatched in the ansible image on 2026-09-06.
    #
    # full-upgrade rather than a named --only-upgrade list: this variant
    # is rebuilt daily from a pinned python:3.14-slim-trixie digest, so
    # every advisory trixie fixes after that digest was cut lands here.
    # Enumerating packages by CVE meant the image only ever carried the
    # fixes someone had already noticed -- on 2026-09-13 that left 23
    # CRITICAL alerts (perl x5, libc6, libc-bin, libglib2.0-0t64), all
    # with a +deb13uN fix already published in the archive.
    && apt-get full-upgrade -y \
    # podman 5 uses netavark; the CNI plugins only add ~15 Go binaries
    # of scanner noise and are not a podman dependency
    && apt-get remove -y --purge containernetworking-plugins \
    # Same reasoning: podman-testing is podman's own test helper, useless
    # in a working image, and its embedded Go stdlib accounted for 53
    # code-scanning alerts on its own.
    && rm -f /usr/libexec/podman/podman-testing \
    && apt-get autoremove -y --purge \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /var/log/dpkg.log /var/log/alternatives.log \
         /var/log/apt/history.log /var/log/apt/term.log \
         /var/cache/ldconfig/aux-cache \
    # systemd's and dbus's postinst write a random machine ID, which made
    # every build differ and gave every container of one image the same
    # ID. The base image ships none; rootless podman runs without one.
    && rm -f /etc/machine-id /var/lib/dbus/machine-id \
    # File capabilities instead of Debian's setuid root, as upstream's podman
    # image ships them. Setuid, rootless podman under Docker stops at "newuidmap:
    # write to uid_map failed: Operation not permitted" unless the container has
    # CAP_SYS_ADMIN, the reason devcontainer.podman.json would need --privileged.
    # These need only CAP_SETUID and CAP_SETGID, which Docker grants by default.
    # /etc/subuid stays as useradd writes it, vscode:100000:65536. Docker has
    # every id, updateRemoteUserUID gives vscode the host's uid, and podman
    # refuses a range that contains it ("includes the user UID"), which any range
    # below 65536 does for somebody, upstream's for every uid but 1000.
    && chmod u-s /usr/bin/newuidmap /usr/bin/newgidmap \
    && setcap cap_setuid=ep /usr/bin/newuidmap \
    && setcap cap_setgid=ep /usr/bin/newgidmap

# The old quay-binary approach shipped a podman that could not even load;
# verify the installed one actually runs in THIS image.
RUN podman --version; \
    if ! podman --version | grep -qE "^podman version (5\.[4-9]|[6-9]|[1-9][0-9])\."; then \
      echo "ERROR: Podman version < 5.4" >&2; exit 1; \
    fi

# Only what the builder changed on top of uv-base, which this stage shares:
# copying /usr/local/lib and /usr/local/bin whole stored the Python stdlib,
# pip and uv a second time. --checksum without -t and --delete as in the
# main Dockerfile, which explains both.
RUN --mount=type=bind,from=python-builder,source=/usr/local,target=/mnt/python-builder \
    rsync -rlpgoD --checksum --delete /mnt/python-builder/lib/ /usr/local/lib/ \
    && rsync -rlpgoD --checksum --delete /mnt/python-builder/bin/ /usr/local/bin/

# DL3064 fires on the *name* containing USERNAME, not on any secret: the
# value is the fixed, public account the Dev Containers specification
# expects every image to provide, and renaming it would break the spec.
# hadolint ignore=DL3064
ARG USERNAME=vscode
ARG USER_UID=1000
ARG USER_GID=${USER_UID}

RUN groupadd --gid "${USER_GID}" "${USERNAME}" \
    # --shell: useradd's default is /bin/sh, and VS Code opens its terminals
    # in the account's login shell when SHELL is not set.
    && useradd --uid "${USER_UID}" --gid "${USER_GID}" --shell /bin/bash -m "${USERNAME}" \
    # Empty the shadow last-change day useradd stamps: see devcontainers/base.
    && sed -i "s/^\(${USERNAME}:[^:]*\):[0-9]*:/\1::/" /etc/shadow \
    && install -d -o "${USERNAME}" -g "${USERNAME}" "${WORKSPACE}" \
    && install -d -o "${USERNAME}" -g "${USERNAME}" "/home/${USERNAME}/.local/share/uv" \
    && install -d -o "${USERNAME}" -g "${USERNAME}" "/home/${USERNAME}/.cache/uv" \
    && install -d -o "${USERNAME}" -g "${USERNAME}" "/home/${USERNAME}/.cache/pre-commit" \
    && install -d -o "${USERNAME}" -g "${USERNAME}" "/home/${USERNAME}/.ansible" \
    && install -d -o "${USERNAME}" -g "${USERNAME}" "/home/${USERNAME}/.local/share/containers" \
    && install -d -o "${USERNAME}" -g "${USERNAME}" "/home/${USERNAME}/.config/containers" \
    && install -d -o "${USERNAME}" -g "${USERNAME}" "/home/${USERNAME}/.config/systemd/user" \
    && install -d -o "${USERNAME}" -g "${USERNAME}" /usr/local/share/devcontainer-skel/ansible \
    # install -d creates intermediate directories as root; podman refuses
    # to run when ~/.config or ~/.local are not owned by the user
    && chown "${USERNAME}:${USERNAME}" \
         "/home/${USERNAME}/.config" \
         "/home/${USERNAME}/.config/systemd" \
         "/home/${USERNAME}/.local" \
         "/home/${USERNAME}/.local/share" \
         "/home/${USERNAME}/.cache" \
    # Rootless podman storage config; written in the same layer that just
    # created ~/.config/containers (docker:S7031 — one layer, not three)
    && printf '[storage]\n\
driver = "overlay"\n\
\n\
[storage.options.overlay]\n\
mount_program = "/usr/bin/fuse-overlayfs"\n\
mountopt = "nodev,metacopy=on"\n' > "/home/${USERNAME}/.config/containers/storage.conf" \
    && chown "${USERNAME}:${USERNAME}" "/home/${USERNAME}/.config/containers/storage.conf" \
    # crun as the OCI runtime
    && printf '[engine]\n\
runtime = "crun"\n\
\n\
[engine.runtimes]\n\
crun = [\n\
  "/usr/bin/crun"\n\
]\n' > "/home/${USERNAME}/.config/containers/containers.conf" \
    && chown "${USERNAME}:${USERNAME}" "/home/${USERNAME}/.config/containers/containers.conf"

COPY --chmod=0444 templates/pre-commit/ansible/.pre-commit-config.yaml /usr/local/share/devcontainer-skel/ansible/.pre-commit-config.yaml
COPY --chmod=0444 templates/ansible/execution-environment.yml /usr/local/share/devcontainer-skel/ansible/execution-environment.yml
COPY --chmod=0555 devcontainers/scripts/ensure-precommit.sh /usr/local/bin/ensure-precommit
COPY --chmod=0555 devcontainers/scripts/podman-smoke-test.sh /usr/local/bin/podman-smoke-test

ENV PATH="/home/${USERNAME}/.local/bin:${PATH}"

# The system file, not ~/.gitconfig. The Dev Containers extension copies the
# user's .gitconfig into the container only when the one already there has
# nothing but [filter] and [safe] sections, so the [init] section this line
# wrote with --global kept the user's name, email and aliases out.
RUN git config --system init.defaultBranch main

USER ${USERNAME}

WORKDIR ${WORKSPACE}

CMD ["/bin/bash"]
